{
  "service": "invoice-router",
  "version": "4.11.2",
  "revision": "9f3c1ad7e2b04c86",
  "environment": "staging",
  "region": "eu-central-1",
  "listen": {
    "host": "0.0.0.0",
    "port": 8443,
    "tls": {
      "enabled": true,
      "certificate": "/srv/app/certs/router.pem",
      "minimum_version": "1.3",
      "ciphers": [
        "TLS_AES_128_GCM_SHA256",
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256"
      ]
    }
  },
  "upstreams": [
    {
      "name": "billing",
      "endpoint": "https://billing.internal.example.com:9443",
      "timeout_ms": 2500,
      "retries": 3,
      "backoff": {
        "initial_ms": 50,
        "multiplier": 2.0,
        "jitter": 0.25,
        "maximum_ms": 4000
      },
      "healthcheck": {
        "path": "/livez",
        "interval_ms": 5000,
        "unhealthy_after": 3
      }
    },
    {
      "name": "catalogue",
      "endpoint": "https://catalogue.internal.example.com:9443",
      "timeout_ms": 900,
      "retries": 1,
      "backoff": {
        "initial_ms": 25,
        "multiplier": 1.5,
        "jitter": 0.1,
        "maximum_ms": 500
      },
      "healthcheck": {
        "path": "/livez",
        "interval_ms": 3000,
        "unhealthy_after": 5
      }
    }
  ],
  "limits": {
    "max_body_bytes": 4194304,
    "max_concurrent_requests": 512,
    "queue_depth": 2048,
    "shed_above_latency_ms": 750
  },
  "telemetry": {
    "metrics_enabled": true,
    "traces_enabled": false,
    "sample_ratio": 0.05,
    "exporter": "otlp",
    "endpoint": "https://collector.internal.example.com:4317",
    "labels": {
      "team": "payments-platform",
      "tier": "edge",
      "owner": "payments-platform@example.com"
    }
  },
  "feature_flags": {
    "async_settlement": false,
    "strict_currency_check": true,
    "legacy_header_fallback": false,
    "shadow_traffic_percent": 0
  }
}
